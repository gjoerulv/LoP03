#pragma once

// GENERATED by CMake from packaging/LICENSES.txt - do not edit. M120: the
// title screen's Credits & Licenses page reads the SAME text the package
// ships, embedded at configure time so there is no runtime file to find, no
// path to sanitize, and nothing to drift (a test pins the third-party names).
// CMake re-runs when LICENSES.txt changes (CMAKE_CONFIGURE_DEPENDS) and
// refuses a text that would outgrow one MSVC string literal.

namespace cd::licenses {

inline constexpr const char* kText = R"ARE_P_GEESE_LIC(@ARE_P_GEESE_LICENSES_TEXT@)ARE_P_GEESE_LIC";

}  // namespace cd::licenses
